# Copy to .env.local and fill in. On EC2, set before `npm run build`
# (NEXT_PUBLIC_* bake in at build time; AWS_* read at runtime).

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AWS S3 (server-only — never NEXT_PUBLIC_) ─────────────
# On EC2, prefer an IAM instance role and OMIT the two key vars below.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_URL=
