# Copy to .env.local and fill in. On EC2, set before `npm run build`
# (NEXT_PUBLIC_* bake in at build time; AWS_* read at runtime).

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AWS S3 (server-only — never NEXT_PUBLIC_) ─────────────
# On EC2, prefer an IAM instance role and OMIT the two key vars below.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_URL=

# News tracker — topic + inbox
NEWS_TRACKER_TOPIC=RGPV Bhopal
NEWS_TRACKER_EMAIL=you@example.com
NEWS_TRACKER_SOURCE=google-news
# NEWS_TRACKER_RSS_URL=https://example.com/feed.xml
NEWS_TRACKER_ENABLED=true

# Protect /api/news-tracker/check in production
CRON_SECRET=replace-with-a-long-random-string

# SMTP for outbound alert mail (Gmail app password, Resend SMTP, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="ABGI News Tracker <alerts@example.com>"
